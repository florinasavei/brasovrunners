# Dependencies
node_modules/

# Yarn 4: keep releases/plugins/patches, ignore the rest of the cache and state.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Build and test output
dist/
build/
coverage/
playwright-report/
test-results/

# Environment: never commit secrets. .env.example is the only tracked env file.
.env
.env.*
!.env.example

# Local databases and caches
*.sqlite
*.db
.cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
