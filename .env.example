# Copy to .env.local for development. Names and safe local examples only; never a real value.
# .env.local is git-ignored. AGENTS.md §8.

# local | test | qa | production. Environment identity; NODE_ENV is not used for this.
APP_ENV=local

# Every absolute URL the app produces derives from this. Match the host you are running on.
APP_BASE_URL=http://localhost:47821

# Neon pooled connection string (the "-pooler" host), Frankfurt. Required from WEEKEND.md step 2.
DATABASE_URL=

# The club's real site, which the "not production" banner links to (AGENTS.md §7.5). Set it in
# qa only: on a laptop there is nowhere else to send anybody, and production never shows the
# banner. Not derived from APP_BASE_URL, which is this environment's own host.
PRODUCTION_SITE_URL=

# The club's own profiles elsewhere. They appear in the footer and as the `sameAs` of the
# SportsOrganization structured data (BR-REQ-052-02). Configuration rather than constants:
# AGENTS.md §8 forbids a hostname under src/. Leave any empty and it is not shown.
CLUB_FACEBOOK_URL=
CLUB_INSTAGRAM_URL=
CLUB_STRAVA_URL=

# Photo storage on Cloudflare R2, qa and production only (SETUP.md §32 is the bucket procedure).
# Locally photos go under .media/ and tests keep them in memory, so leave these empty on a
# laptop. All five, or none: a deployed environment without them has no gallery uploads and
# says so on /admin/tasks. R2_ENDPOINT is the bucket's S3 endpoint from the R2 dashboard;
# R2_PUBLIC_BASE_URL is where its objects are read (the r2.dev subdomain, or a custom domain).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Read-only, optional: /devs shows the database's CU-hours this month against the Neon Free
# plan's 100 when both are set (SETUP.md §33). A personal API key from the Neon console and the
# project id from its URL. Nothing else reads them; leave empty locally.
NEON_API_KEY=
NEON_PROJECT_ID=
# Read-only, optional: /devs shows this month's deployments and build minutes against Vercel
# Hobby's 6,000 when both are set (DECISIONS.md §101). Vercel → Account → Tokens (scope: this
# account, expiry: a year) and the project id from the project's Settings → General. Bandwidth
# and invocations are on the dashboard only; Vercel's API does not expose them.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# dev-switcher | provider | disabled. AGENTS.md §8 and §13.1; BR-REQ-060-01;
# DECISIONS.md §26. Leave it unset and it derives: the development staff switcher in local and
# test, `disabled` everywhere else. `provider` is Auth.js with Zitadel — set it, and the four
# variables below, once a Zitadel tenant exists for this environment. Setting dev-switcher with
# APP_ENV=qa or production refuses to start.
STAFF_AUTH_MODE=

# Required when STAFF_AUTH_MODE=provider. Verify the exact names against Auth.js's current
# documentation before relying on this list — AUTH_SECRET is Auth.js's own session secret;
# the other three are this Zitadel application's credentials and issuer URL.
AUTH_SECRET=
AUTH_ZITADEL_ID=
AUTH_ZITADEL_SECRET=
AUTH_ZITADEL_ISSUER=

# Verifies a scheduler calling the two job endpoints (AGENTS.md §16.2) — a Bearer secret, not a
# staff session. Compared in constant time; any sufficiently random value works.
JOB_SECRET=

# How often the day-time monitor pings the two job endpoints, in minutes — the health check calls
# a job stale after twice this plus five. 15 on production; 60 on QA, which is pinged hourly to
# spare its free CU-hours (DECISIONS.md §68, §148). Night is hourly everywhere.
PINGER_CADENCE_MINUTES=15

# capture | allowlist | live. AGENTS.md §7.2 and §16.4; BR-REQ-080-03.
# capture keeps every message in memory and transmits nothing — the only mode local and test
# accept. allowlist transmits only to EMAIL_ALLOWLIST and captures the rest, which is what a
# Mailgun sandbox domain is. live is refused unless APP_ENV=production, and the process will
# not start otherwise.
EMAIL_DELIVERY_MODE=capture

# Comma-separated addresses allowlist mode may transmit to. Compared by canonical identity,
# so a Gmail alias of an authorized address is authorized too.
# In allowlist mode: the authorized addresses, comma-separated — or the single entry * , which
# authorizes every recipient (DECISIONS.md §163). A star is for a QA deployment whose testers
# are more than a handful; every message still carries the [QA] mark, and the star is one
# character to remove.
EMAIL_ALLOWLIST=

# Required by allowlist and live. MAILGUN_DOMAIN is the sending domain: a sandbox
# (sandboxNNN.mailgun.org) needs no DNS and reaches only the addresses authorized in Mailgun,
# which is exactly what allowlist mode is for; the club's own domain replaces it later with no
# code change.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Mailgun's API base for your region. US: https://api.mailgun.net/v3 — EU: https://api.eu.mailgun.net/v3
# Configuration rather than a literal: AGENTS.md §8 forbids a hostname under src/ and exempts no
# provider, and the region genuinely differs.
MAILGUN_API_BASE_URL=

# Who the email comes from, and where a reply goes (AGENTS.md §8: a sending address contains a
# hostname, so it is configuration and never a literal).
#
# EMAIL_FROM_ADDRESS defaults to noreply@<MAILGUN_DOMAIN>, which is valid on a sandbox from the
# moment the account exists. The club's real sender name and address are an owner decision
# (BUSINESS.md §9).
#
# EMAIL_REPLY_TO is the whole of "people can reply": unset, a reply to a noreply@ sender goes
# nowhere. Point it at a mailbox the club actually reads.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
# The club's legal identity, written into the legal templates by "start from the platform's
# text" (DECISIONS.md §132): the full legal name, the fiscal registration number (CIF) and the
# registered seat as on the ANAF certificate. Kept out of the repository on purpose (it is
# public); set on the Vercel projects and in .env.local. Empty = the placeholders stay.
CLUB_LEGAL_NAME=
CLUB_REGISTRATION_NUMBER=
CLUB_REGISTERED_ADDRESS=
# The club's archive mailbox for signed declarations (DECISIONS.md §99): set, every signed
# declaration is also emailed there as a PDF; one more message per registration on the
# Mailgun allowance. Leave empty to keep only the participant's copy and the event bundle.
DECLARATIONS_ARCHIVE_TO=

# The contact form's own way out (DECISIONS.md §149): plain SMTP through the club's Gmail with an
# app password, never through Mailgun or the outbox — correspondence, not transactional mail.
# Google account → Security → 2-Step Verification (on) → App passwords → "Brașov Runners site":
# the 16 characters are CONTACT_SMTP_PASSWORD; CONTACT_SMTP_USER is the Gmail address itself.
# CONTACT_FORM_TO is where the message lands — comma-separated, the Gmail and a colleague's
# Yahoo. Host and port default to Google's (smtp.gmail.com, 465). Locally and in tests nothing
# is sent: the message is captured and shown on /devs. Unset on a deployment, the page shows
# "write to us at <EMAIL_REPLY_TO>" instead of the form.
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FORM_TO=

# Verifies inbound Mailgun webhooks (AGENTS.md §16.5) — a different secret from the API key
# above, since it authenticates the opposite direction. Requests are refused with 503 until
# this is set, which is the correct state before Mailgun is wired at all.
MAILGUN_WEBHOOK_SIGNING_KEY=

# Feature flags (DECISIONS.md §95). Off unless "true".
# FEATURE_DISPLAY_NAME — the form offers "appear publicly under another name". The club's
# organiser wants real names on the list and kits handed out against an identity card.
FEATURE_DISPLAY_NAME=false

# Cloudflare Turnstile on the registration form (DECISIONS.md §97). Both keys or neither.
# Cloudflare dashboard → Turnstile → Add widget (the site's hostname, "Managed") → copy both.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
