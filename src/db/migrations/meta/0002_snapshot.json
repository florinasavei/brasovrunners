      "checkConstraints": {
        "events_capacity_must_be_null_during_pilot": {
          "name": "events_capacity_must_be_null_during_pilot",
          "value": "\"events\".\"capacity\" IS NULL"
        },
        "events_capacity_and_declaration_are_internal_only": {
          "name": "events_capacity_and_declaration_are_internal_only",
          "value": "(\"events\".\"registration_mode\" = 'INTERNAL') OR (\"events\".\"capacity\" IS NULL AND \"events\".\"declaration_document_id\" IS NULL)"
        },
        "events_external_fields_external_only": {
          "name": "events_external_fields_external_only",
          "value": "(\"events\".\"registration_mode\" = 'EXTERNAL' AND \"events\".\"external_registration_url\" LIKE 'https://%')\n          OR (\"events\".\"registration_mode\" <> 'EXTERNAL' AND \"events\".\"external_registration_url\" IS NULL AND \"events\".\"external_provider\" IS NULL)"
        },
        "events_end_after_start": {
          "name": "events_end_after_start",
          "value": "\"events\".\"ends_at\" IS NULL OR \"events\".\"ends_at\" > \"events\".\"starts_at\""
        },
        "events_non_negative_measurements": {
          "name": "events_non_negative_measurements",
          "value": "(\"events\".\"distance_meters\" IS NULL OR \"events\".\"distance_meters\" >= 0)\n          AND (\"events\".\"elevation_gain_meters\" IS NULL OR \"events\".\"elevation_gain_meters\" >= 0)"
        },
        "events_registration_window_ordered": {
          "name": "events_registration_window_ordered",
          "value": "\"events\".\"registration_opens_at\" IS NULL OR \"events\".\"registration_closes_at\" IS NULL\n          OR \"events\".\"registration_closes_at\" >= \"events\".\"registration_opens_at\""
        },
        "events_race_id_implies_race_kind": {
          "name": "events_race_id_implies_race_kind",
          "value": "\"events\".\"race_id\" IS NULL OR \"events\".\"kind\" = 'RACE'"
        }
      },
