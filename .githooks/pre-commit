#!/bin/sh
# Brasov Runners pre-commit hook.
#
# Two guards, in this order: the branch, then the fast checks. The branch comes first
# because it costs nothing.
#
# Installed by `yarn setup`, which sets core.hooksPath to .githooks.
# Emergency bypass: git commit --no-verify. Fix before pushing; CI still blocks the merge.

# --- 0. Forget git's own environment ---------------------------------------------------
#
# git exports GIT_DIR and GIT_INDEX_FILE (and in some commands GIT_WORK_TREE and GIT_PREFIX)
# into a hook, and every process below inherits them. On 2026-09-28 a test's throwaway fixture
# ran `git init`, `git add` and `git rm` with them set, so its git worked on the repository being
# committed: 1 942 staged deletions in the committing worktree's index, and later `core.bare=true`
# in the main checkout's config (§553). Without them every git below finds its repository from
# the current directory — the hook runs at the worktree's top, so the checks read the same one.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX

# --- 1. Never commit on a protected branch --------------------------------------------
#
# CLAUDE.md is explicit: "Commit on a feature branch, push it, open the PR into qa; never
# push to qa or main." That rule was broken on 2026-09-21 — the working tree was left on
# `qa` after a merge, a commit was made without re-reading the branch, and it went
# straight to the shared branch with no review.
#
# A rule that lives only in a document is a rule somebody forgets while concentrating on
# something else. This is the same rule, in the one place that can actually stop it.

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

case "$branch" in
	qa | main)
		echo ""
		echo "pre-commit: refusing to commit directly on '$branch'."
		echo ""
		echo "  Work goes on a branch and reaches $branch through a pull request"
		echo "  (CLAUDE.md, Working conventions). To move what you have:"
		echo ""
		echo "      git checkout -b <name> --no-track origin/qa"
		echo ""
		echo "  Deliberate exception — a release merge, say: git commit --no-verify"
		echo ""
		exit 1
		;;
esac

# --- 2. The fast half of `yarn check`, and the tests of what is staged ------------------
#
# The owner, 2026-10-27: «rulezi cam multe teste la fiecare commit, e cam stupid sincer». The whole
# suite (16 000+ tests, about ten minutes) ran on every commit, a one-line document included. Now:
# `check:static` (docs, secrets, migrations, types, lint — everything but the tests), then only the
# tests that import a staged file (`vitest related`). The whole suite still runs in CI on every pull
# request (.github/workflows/docs-check.yml, four shards) and blocks the merge; `yarn check` runs it
# all locally on demand.
#
# Since §867 (2026-10-28) only the categories `yarn test:fast` runs (tests/categories.mjs: «trust» —
# the rules that cannot be broken, always — then «guards» and «logic»); «database», «pages» and
# «drawn» are CI's. `yarn test:categories` says which file is where.
#
# Since §871 (2026-10-29) only the tests that import a staged file DIRECTLY, not `vitest related`'s
# transitive closure (299 files and six minutes for a three-function module), and ESLint keeps a
# cache (`yarn lint`: 84 s cold, 5 s warm). CI still runs everything.

if ! yarn check:static; then
	echo ""
	echo "pre-commit: 'yarn check:static' failed, so the commit was blocked."
	echo "Fix the problems above, or bypass with --no-verify and fix before pushing."
	exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*' 'tests/*' 'messages/*' 'scripts/*' | grep -E '\.(ts|tsx|json|mjs)$' || true)
if [ -n "$staged" ]; then
	# shellcheck disable=SC2086 # one argument per staged path; paths here carry no spaces
	if ! node scripts/test-categories.mjs direct $staged; then
		echo ""
		echo "pre-commit: the tests of the staged files failed, so the commit was blocked."
		echo "Fix the problems above, or bypass with --no-verify and fix before pushing."
		exit 1
	fi
fi
