{
  "name": "brasovrunners",
  "version": "0.0.0",
  "private": true,
  "description": "Brașov Runners website and event registration platform. Documentation baseline; application code arrives in PR 1 (SETUP.md §29).",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx --env-file-if-exists=.env.local src/db/seeds/pilot.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "yarn docs:check && yarn typecheck && yarn lint && yarn test",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "22.14.0"
  }
}
